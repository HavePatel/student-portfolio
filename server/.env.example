# Server Environment Variables (Express + MongoDB + JWT Auth + Nodemailer)
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/student_portfolio
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=your-secret-here
JWT_EXPIRES_IN=15m
# Inactivity timeout in milliseconds (server-side enforcement, default 30000)
INACTIVITY_TIMEOUT_MS=30000

# SMTP / Nodemailer (Gmail App Password recommended)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-16-character-app-password
MAIL_FROM=your-email@gmail.com

# Optional TLS / CA configuration for local development / enterprise proxies
# MAIL_CA_PATH=C:/path/to/custom-ca.pem
# MAIL_TLS_ALLOW_INSECURE=false
# MAIL_REJECT_UNAUTHORIZED=true
